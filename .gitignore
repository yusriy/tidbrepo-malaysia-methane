# Credentials and machine-specific settings
.env
*.env
.codex/

# Python environment and caches
.venv/
__pycache__/
*.py[cod]

# Locally held papers — redistribution rights not assumed
*.pdf

# Large reproducible search responses and downloaded sources
# Complete monthly packages stay local; publish curated findings in the wiki.
# Previously tracked historical run files remain tracked and are preserved.
knowledge_base/literature_updates/runs/*/
knowledge_base/literature_updates/runs/*/raw/
knowledge_base/literature_updates/runs/*/sources/

# Runtime state (notification receipts and publication worktrees stay local)
knowledge_base/literature_updates/state/*
knowledge_base/literature_updates/state/latest_run_path.txt
knowledge_base/literature_updates/state/monthly-run.lock
*.log

# SQLite temporary files
*.sqlite-wal
*.sqlite-shm

# Transfer packages and operating-system files
*.tar.gz
.DS_Store
.Rhistory

# Complete factor audit snapshots, mail claims and receipts remain local
knowledge_base/plausibility_audits/runs/
